---
// DEV ONLY: bakes the listening room's ambient occlusion on the GPU and sends
// it to the dev server, which writes src/assets/bake/. Never published (the
// build drops it, see astro.config.mjs). Normally run headless with
// `npm run bake`; open /bake by hand to use the button.
//
//   /bake?spp=256&density=128&dist=0.9&strength=1.4&min=0.3&auto=1
//
//   spp       rays per sample (default 256)
//   density   atlas texels per metre for flat faces (default 128)
//   dist      occluders further than this, in metres, are ignored (default 0.9)
//   strength  multiplies occlusion before it is stored (default 1.4)
//   min       AO never goes below this (default 0.3)
//   auto=1    start at once, no button
import record1 from '../assets/record-1.jpg';
import record2 from '../assets/record-2.jpg';
import record3 from '../assets/record-3.jpg';
import record4 from '../assets/record-4.jpg';
import { music } from '../data/site';
const covers = JSON.stringify([record1, record2, record3, record4].map((r) => r.src));
const records = JSON.stringify(music.records.map(({ title, artist, url }) => ({ title, artist, url })));
const gear = JSON.stringify(Object.fromEntries(music.photos.map(({ id, title, text }) => [id, { title, text }])));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Room bake</title>
    <style>
      body {
        margin: 2rem;
        font: 15px/1.5 system-ui, sans-serif;
        background: #1d1b19;
        color: #eae4d9;
      }
      button {
        font: inherit;
        padding: 0.4rem 1rem;
      }
      pre {
        white-space: pre-wrap;
      }
      #stage {
        position: absolute;
        left: -9999px;
        width: 1280px;
        height: 720px;
      }
      .room {
        display: none;
      }
    </style>
  </head>
  <body>
    <h1>Room lighting bake</h1>
    <p><button id="go">Bake</button></p>
    <pre id="log"></pre>
    <div id="stage" data-covers={covers} data-records={records} data-gear={gear}></div>
    <script>
      import { THREE } from '../scripts/room/kit';
      import { mountRoom } from '../scripts/room/scene';
      import { collectScene } from '../scripts/room/lightbake-common';
      import { runBake } from '../scripts/room/bakegpu';

      const q = new URLSearchParams(location.search);
      const num = (k: string, d: number) => (q.has(k) ? Number(q.get(k)) : d);
      const logEl = document.getElementById('log')!;
      const log = (s: string) => {
        logEl.textContent += s + '\n';
        console.log(s);
      };
      const post = (path: string, data: unknown) =>
        fetch(path, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) }).then((r) => {
          if (!r.ok) throw new Error(`${path}: ${r.status}`);
          return r.json();
        });
      const b64 = (a: Uint8Array) => {
        let s = '';
        for (let i = 0; i < a.length; i += 0x8000) s += String.fromCharCode(...a.subarray(i, i + 0x8000));
        return btoa(s);
      };
      const report = (data: Record<string, unknown>) => post('/__bake/progress', data).catch(() => {});

      // The bake's own renderer, on the fast GPU where there is a choice.
      const renderer = new THREE.WebGLRenderer({ antialias: false, powerPreference: 'high-performance' });
      const gl = renderer.getContext();
      const dbg = gl.getExtension('WEBGL_debug_renderer_info');
      const gpu = dbg ? String(gl.getParameter(dbg.UNMASKED_RENDERER_WEBGL)) : String(gl.getParameter(gl.RENDERER));
      log('GPU: ' + gpu);
      void report({ gpu, label: 'ready', fraction: 0 });

      let running = false;
      async function bake() {
        if (running) return;
        running = true;
        (document.getElementById('go') as HTMLButtonElement).disabled = true;
        try {
          const stage = document.getElementById('stage')!;
          await report({ label: 'Building the room', fraction: 0 });
          const room = mountRoom(stage, {
            covers: JSON.parse(stage.dataset.covers ?? '[]'),
            reducedMotion: true,
            mood: 'day',
            records: JSON.parse(stage.dataset.records ?? '[]'),
            gear: JSON.parse(stage.dataset.gear ?? '{}'),
          });
          await new Promise((r) => setTimeout(r, 500));
          const collected = collectScene(room.scene, true);
          room.dispose();
          log(`Meshes ${collected.meshes.length}, flat faces ${collected.patches.length}`);

          const t0 = performance.now();
          const spp = num('spp', 256);
          const result = await runBake(renderer, collected, {
            spp,
            density: num('density', 128),
            maxDist: num('dist', 0.9),
            strength: num('strength', 1.4),
            minAo: num('min', 0.3),
            bias: 0.004,
            log,
            progress: (label, fraction) => {
              const line = `${label}: ${Math.round(fraction * 100)}%`;
              document.title = line;
              void report({ label, fraction });
              if (Math.round(fraction * 100) % 10 === 0) log(line);
            },
          });
          log(`Baked in ${((performance.now() - t0) / 1000).toFixed(1)} s; atlas ${result.manifest.atlas.w}x${result.manifest.atlas.h}, ${result.manifest.meshes.length} meshes with vertex data (${result.vertex.length} bytes)`);
          await report({ label: 'Saving', fraction: 1 });
          const written = await post('/__bake', { manifest: result.manifest, atlas: b64(result.atlas), vertex: b64(result.vertex) });
          log('Written: ' + JSON.stringify(written));
          (window as any).__bakeDone = true;
        } catch (e) {
          log('FAILED: ' + (e as Error).message);
          await report({ error: String((e as Error).stack ?? e) });
          (window as any).__bakeError = String(e);
        }
        running = false;
      }
      document.getElementById('go')!.addEventListener('click', bake);
      if (q.get('auto') === '1') void bake();
    </script>
  </body>
</html>
